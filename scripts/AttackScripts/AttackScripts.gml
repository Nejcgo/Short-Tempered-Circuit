/// @desc Creates a new attack struct
/// @param {real} _x 
/// @param {real} _y 
/// @param {asset.gmobject} _obj Object to use as oBullet
/// @param {real} _damage Amount of damage bullets will deal
/// @param {real} _type How to spawn the bullets
function Attack(_x, _y, _obj, _damage, _type) constructor {
    x = _x;
    y = _y;
    obj = _obj;
    damage = _damage;
    type = _type;
    
    
}